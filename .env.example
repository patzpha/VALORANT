# Copie este arquivo para ".env" e preencha com seus dados
# (NUNCA suba o .env real pro GitHub)

# Discord Developer Portal > sua aplicação > Bot
DISCORD_TOKEN=coloque_o_token_do_bot_aqui

# Discord Developer Portal > sua aplicação > OAuth2 > General
CLIENT_ID=coloque_o_client_id_aqui
CLIENT_SECRET=coloque_o_client_secret_aqui

# URL completa onde o site vai ficar hospedado + /auth/callback
# Exemplo local: http://localhost:3000/auth/callback
# Exemplo Railway: https://seu-app.up.railway.app/auth/callback
REDIRECT_URI=http://localhost:3000/auth/callback

# Qualquer texto aleatório e secreto, usado para proteger a sessão do login
SESSION_SECRET=troque_isso_por_um_texto_aleatorio_grande

# Usuário e senha da tela de entrada do painel (antes do login do Discord)
# Troque esses valores antes de colocar o site no ar de verdade
PAINEL_USUARIO=TOTAL
PAINEL_SENHA=CONTROLE

PORT=3000
